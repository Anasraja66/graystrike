# ============================================
# APT AGENTS — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git!
# ============================================

# Database
POSTGRES_USER=aptuser
POSTGRES_PASSWORD=aptpassword_change_me
POSTGRES_DB=aptdb
DATABASE_URL=postgresql+asyncpg://aptuser:aptpassword@localhost:5432/aptdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your_super_secret_key_min_32_chars_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI APIs
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# App
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# Email (for verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Stripe (Billing - optional for now)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
